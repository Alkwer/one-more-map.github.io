{
  "name": "allflame-voyage-solver",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude \"**/tests/performance/**\" --exclude \"**/e2e/**\" --exclude \"**/.sites/**\" --exclude \"**/.worktrees/**\"",
    "test:data": "node --test scripts/border-roll-data.node-test.mjs",
    "test:performance": "vitest run tests/performance/solver-performance-budget.test.ts",
    "lint": "eslint . --max-warnings 0",
    "check:eol": "node scripts/check-line-endings.mjs",
    "format:eol": "node scripts/check-line-endings.mjs --write",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "validate": "npm run typecheck && npm test && npm run test:data && npm run lint && npm run check:eol && npm run format:check && npm run build",
    "bench:solver": "vitest bench --run benchmarks/solver-performance.bench.ts",
    "preview": "vite preview",
    "stage:pages": "node scripts/stage-pages.mjs",
    "build:pages": "npm run build && npm run stage:pages",
    "preview:pages": "vite preview --outDir staging",
    "test:e2e": "npm run build:pages && playwright test",
    "test:e2e:exit": "npm run build:pages && node scripts/check-playwright-exit.mjs",
    "test:e2e:ui": "npm run build:pages && playwright test --ui"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.13.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vitest": "4.1.10"
  }
}
